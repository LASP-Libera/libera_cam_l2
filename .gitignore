# External, machine-local real data (never distributed via this repo --
# see docs/GETTING_STARTED.md for where new users get these and how to
# point the repo at them).
data/DITL2
data/DITL2/

# Generated pipeline output (manifests, proxy imagery cache, QA plots,
# run log). This used to be apps/l2/data/ -- a leftover default path
# string copied verbatim from libera-cam-proxy's own apps/l2/ layout,
# which this standalone repo doesn't have (everything lives directly
# under l2/). Fixed 2026-11-03; now under l2/data/.
l2/data/

# SHDOM scratch and per-process logs written at the repo root during a run.
tmp-data/
shdom-run*.sHdOmNG-log.*

# cam_l2's own sample/reference data (surface mask, BRDF climatology,
# demo camera L1B) -- external, large (~700MB combined), never
# distributed via this repo. data/sample/input.yml itself IS tracked
# (tiny config); see docs/GETTING_STARTED.md for where new users get
# the data it references.
data/sample/surface_mask
data/sample/surface_mask/
data/sample/cam_l1b
data/sample/cam_l1b/
data/sample/brdf_parms
data/sample/brdf_parms/
